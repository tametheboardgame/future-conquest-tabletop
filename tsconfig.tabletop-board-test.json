{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "src/tabletop",
    "outDir": ".tabletop-test-dist",
    "noEmit": false
  },
  "include": [
    "src/tabletop/board.ts",
    "src/tabletop/state.ts",
    "src/tabletop/pieces.ts",
    "src/tabletop/command-phase.ts",
    "src/tabletop/combat.ts",
    "src/tabletop/core-actions.ts"
  ]
}
